# ============================================================
# Mail Service (SMTP + REST API)
# ============================================================
MONGO_URL=mongodb://mongodb:27017
DB_NAME=mailserver
JWT_SECRET=your-strong-jwt-secret-here
API_KEY=your-api-key-here
SMTP_HOSTNAME=mail.yourdomain.com
DOMAINS=yourdomain.com
# Public IPv4 of this server. Used in the A record and SPF record shown on the Setup screen.
SERVER_IP=
# Host name mail apps (Thunderbird / Android) should use for IMAP. Defaults to SMTP_HOSTNAME.
IMAP_HOSTNAME=
# Encrypts SMTP passwords and DKIM keys stored in the database. Use 32+ random characters.
# Keep it safe: if you lose or change it, saved SMTP passwords must be re-entered.
SECRETS_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://127.0.0.1:5000
# Web app listen address. 127.0.0.1 = this server only; 0.0.0.0 = reachable by a reverse proxy on another machine.
WEB_BIND=127.0.0.1
# How many reverse proxies sit in front of the web app (1 = Nginx Proxy Manager or Caddy; 2 = a Cloudflare Tunnel in front of that).
# Used to find the real visitor address for login rate limiting.
TRUSTED_PROXY_COUNT=1
# Hours a login stays valid.
SESSION_HOURS=168
API_PORT=8080
SMTP_PORT=25
ENABLE_API_DOCS=0
EXPOSE_HEALTH_DETAILS=0
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=60
SMTP_RCPT_RATE_WINDOW=60
SMTP_RCPT_RATE_MAX=100
SMTP_DATA_RATE_WINDOW=60
SMTP_DATA_RATE_MAX=20
SMTP_MAX_RCPTS_PER_MESSAGE=20
SMTP_MAX_MESSAGE_BYTES=1048576
SMTP_MAX_ADDRESS_LENGTH=320
SMTP_BLACKLIST_IPS=
SMTP_BLACKLIST_SENDERS=
SMTP_GREYLIST_ENABLED=0
SMTP_GREYLIST_DELAY_SECONDS=60
SMTP_GREYLIST_TTL_SECONDS=3600
# 0 = keep mail forever (default). Set e.g. 3 to auto-delete disposable mail after 3 days.
MESSAGE_TTL_DAYS=0

# TLS / STARTTLS (optional - mount certs in docker-compose.yml)
# SMTP_TLS_CERT=/certs/fullchain.pem
# SMTP_TLS_KEY=/certs/privkey.pem

# ============================================================
# Mail Viewer (Web UI)
# ============================================================
ENVIRONMENT=production
DUCKMAIL_API_KEY=same-as-API_KEY-above
ACCESS_PASSWORD=your-viewer-login-password
SECRET_KEY=random-flask-session-secret
MAX_IMAGE_PROXY_BYTES=5242880
# Production default is disabled. Set to 1 only if the viewer is strongly protected.
AUTO_CREATE_ACCOUNTS=0
LOGIN_RATE_LIMIT_WINDOW=300
LOGIN_RATE_LIMIT_MAX=10
SENSITIVE_RATE_LIMIT_WINDOW=60
SENSITIVE_RATE_LIMIT_MAX=20

# ============================================================
# External IMAP Bridge (Optional - stores Gmail/Outlook/etc accounts)
# ============================================================
# encrypted = save external IMAP accounts only when IMAP_ACCOUNT_ENCRYPTION_KEY is set.
# disabled = never persist external IMAP accounts.
IMAP_ACCOUNT_PERSISTENCE=encrypted
# Use a strong 32+ character key. Leave empty to skip persistence.
IMAP_ACCOUNT_ENCRYPTION_KEY=

# Sending is configured in the web UI: Setup > 3rd-party SMTP.
# Outgoing attachment limits (raw bytes, before base64 encoding).
MAX_ATTACHMENT_BYTES=5242880
MAX_ATTACHMENT_TOTAL_BYTES=10485760
MAX_ATTACHMENT_COUNT=10
# Request body cap for the viewer. Defaults to the total attachment size plus headroom.
# MAX_CONTENT_LENGTH=16097152

# ============================================================
# IMAP Server (Optional - for desktop/mobile mail clients)
# ============================================================
# IMAP_CERTS_PATH=/etc/letsencrypt/live/mail.yourdomain.com
# Or use a local certs/ directory with fullchain.pem + privkey.pem

# ============================================================
# Sending from mail apps with SMTP keys (Setup > APIs)
# ============================================================
# Ports 587 (STARTTLS) and 465 (SSL/TLS) use the same certificate as IMAP (above).
# 127.0.0.1 closes them to the outside; SUBMISSION_ENABLED=0 turns them off.
# SUBMISSION_BIND=0.0.0.0
# SUBMISSION_ENABLED=1
# Per key: messages per hour (changeable per key) and recipients per message.
# RELAY_HOURLY_LIMIT=100
# RELAY_MAX_RCPTS=50

# ============================================================
# Drive, Calendar and storage
# ============================================================
# Storage per mailbox (mail + Drive files) in MB. 0 = unlimited. Changeable per user under Setup > Users.
# DEFAULT_QUOTA_MB=5120
# Largest single upload, and the most Drive files attached to one email (MB).
# DRIVE_MAX_FILE_MB=100
# ATTACH_FROM_DRIVE_MAX_MB=20
# The public address of the web app, used in share links (/s/...). Defaults to CORS_ORIGINS.
# PUBLIC_URL=https://mail.yourdomain.com

# ============================================================
# Security (Setup > Security in the web app)
# ============================================================
# Check SPF / DKIM / DMARC on incoming mail and warn about fake senders (1 = on).
CHECK_SENDER_AUTH=1
# Refuse mail that fails DMARC when the sender's domain publishes p=reject (0 = only warn).
SMTP_ENFORCE_DMARC_REJECT=0
# How long the security log (connections, sign-ins, failed passwords) is kept, in days.
SECURITY_LOG_DAYS=30
# Personal accounts (Setup > Users): when on, ACCESS_PASSWORD no longer signs in. Set to 1 only while you
# need the emergency admin login (email "admin" + ACCESS_PASSWORD), e.g. if the admin mailbox is locked out.
ALLOW_EMERGENCY_ADMIN=0

# Inbox flood warning: emails per hour to one mailbox before the inbox shows a warning (default 30)
# MAIL_FLOOD_THRESHOLD=30
